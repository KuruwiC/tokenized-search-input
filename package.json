{
  "name": "tokenized-search-input",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @kuruwic/demo dev",
    "build": "pnpm --filter @kuruwic/tokenized-search-input build",
    "build:demo": "DEMO_BASE=/tokenized-search-input/ pnpm --filter @kuruwic/demo build",
    "preview": "pnpm --filter @kuruwic/demo preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "lint:unused": "knip --workspace packages/core",
    "docs:check": "node scripts/check-readme-examples.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kuruwic/tokenized-search-input test",
    "test:run": "pnpm --filter @kuruwic/tokenized-search-input test:run",
    "test:coverage": "pnpm --filter @kuruwic/tokenized-search-input test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "knip": "6.39.0",
    "publint": "0.3.24",
    "typescript": "^5.7.2"
  }
}
